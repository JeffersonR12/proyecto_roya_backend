APP_NAME=Roya
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Recuperacion de contraseña.
# - Desarrollo: MAIL_MAILER=log escribe el correo (con el enlace) en storage/logs/laravel.log.
# - Envio real con Gmail: activa verificacion en 2 pasos, crea una "contraseña de aplicacion"
#   (https://myaccount.google.com/apppasswords) y usa:
#     MAIL_MAILER=smtp  MAIL_HOST=smtp.gmail.com  MAIL_PORT=587  MAIL_SCHEME=null
#     MAIL_USERNAME=tu_cuenta@gmail.com  MAIL_PASSWORD=<contraseña de aplicacion>
#     MAIL_FROM_ADDRESS=tu_cuenta@gmail.com
#   APP_URL debe ser la URL real de la app: el enlace del correo se construye con ella.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Sanctum: la PWA usa la cookie de sesion contra /api (mismo origen).
# Solo hace falta si el frontend se sirve desde otro dominio:
# SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1:8000,app.midominio.pe

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
